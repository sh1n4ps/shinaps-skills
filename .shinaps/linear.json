{
  "$schema": "https://cdn.jsdelivr.net/npm/@shinaps/skills@0.39.0/plugins/shinaps-claude/references/linear/configuration.schema.json",
  "config_version": 2,
  "config_storage": "shared",
  "target": {
    "workspace": "shinaps",
    "team": "SHINAPS",
    "project": "https://linear.app/shinaps/project/shinaps-ai-76ed13db8314"
  },
  "team_settings": "manage_on_setup",
  "statuses": {
    "todo": "Todo",
    "refinement": "In Progress",
    "ready": "Ready",
    "coding": "Coding",
    "local_agent_qa": "Local Agent QA",
    "code_review": "Agent QA",
    "post_commit": "Agent QA",
    "staging_agent_qa": "Staging Agent QA",
    "staging_human_qa": "Staging Human QA",
    "release": "In Progress",
    "production_agent_qa": "Production Agent QA",
    "production_human_qa": "Production Human QA",
    "human_input": "Human Input",
    "done": "Done"
  },
  "stop_after": "issue_done",
  "review_flow": {
    "mode": "auto"
  },
  "permissions": [
    "development_operations",
    "issue_update",
    "claude_cli",
    "claude_cli_bypass_permissions",
    "bridge_request",
    "dev_delegation",
    "push",
    "pr_create",
    "merge",
    "publish:github_release",
    "publish:npm"
  ],
  "references": {
    "specifications": [
      "README.md",
      "docs/development.md",
      ".shinaps/linear/instructions.md"
    ],
    "validation": [
      "package.json",
      ".github/workflows/publish.yml"
    ],
    "publication": [
      "docs/development.md",
      ".github/workflows/publish.yml"
    ],
    "environments": [],
    "deployment": []
  },
  "path_policy_overrides": [],
  "cycle_report": null
}
