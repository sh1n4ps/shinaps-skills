{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cdn.jsdelivr.net/npm/@shinaps/skills@0.32.1/plugins/shinaps-claude/references/linear/configuration.schema.json",
  "title": "Shinaps Linear configuration v1",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "config_version": {
      "type": "integer",
      "const": 1
    },
    "config_storage": {
      "enum": ["shared", "local"]
    },
    "target": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "team": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["workspace", "team", "project"],
      "additionalProperties": false
    },
    "team_settings": {
      "enum": ["existing_only", "manage_on_setup"]
    },
    "statuses": {
      "type": "object",
      "properties": {
        "todo": {
          "type": "string",
          "minLength": 1
        },
        "refinement": {
          "type": "string",
          "minLength": 1
        },
        "ready": {
          "type": "string",
          "minLength": 1
        },
        "coding": {
          "type": "string",
          "minLength": 1
        },
        "local_agent_qa": {
          "type": "string",
          "minLength": 1
        },
        "code_review": {
          "type": "string",
          "minLength": 1
        },
        "post_commit": {
          "type": "string",
          "minLength": 1
        },
        "staging_agent_qa": {
          "type": "string",
          "minLength": 1
        },
        "staging_human_qa": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "production_agent_qa": {
          "type": "string",
          "minLength": 1
        },
        "production_human_qa": {
          "type": "string",
          "minLength": 1
        },
        "human_input": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "stop_after": {
      "enum": ["pre_push_qa", "pr_created", "issue_done"]
    },
    "implementation_skill": {
      "enum": ["dev-claude", "dev-codex", "dev-managed-cc"]
    },
    "review_flow": {
      "$ref": "#/definitions/reviewFlow"
    },
    "path_policy_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review_flow": {
            "$ref": "#/definitions/reviewFlow"
          }
        },
        "required": ["paths", "review_flow"],
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "enum": [
              "issue_update",
              "development_operations",
              "codex_task",
              "claude_cli",
              "bridge_request",
              "push",
              "pr_create",
              "merge",
              "dev_delegation"
            ]
          },
          {
            "type": "string",
            "pattern": "^managed_session:[1-9][0-9]*$"
          },
          {
            "type": "string",
            "pattern": "^(deploy|publish|evidence):[^\\s]+$"
          }
        ]
      }
    },
    "references": {
      "type": "object",
      "properties": {
        "specifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deployment": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "publication": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["specifications", "validation", "environments", "deployment", "publication"],
      "additionalProperties": false
    },
    "cycle_report": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "qa_scope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "destination": {
              "type": "string",
              "minLength": 1
            },
            "index": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "audience": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["qa_scope", "destination", "index", "audience", "format"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "config_version",
    "config_storage",
    "target",
    "team_settings",
    "statuses",
    "stop_after",
    "implementation_skill",
    "review_flow",
    "path_policy_overrides",
    "permissions",
    "references",
    "cycle_report"
  ],
  "additionalProperties": false,
  "definitions": {
    "reviewFlow": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "auto"
            }
          },
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "manual"
            },
            "tool": {
              "enum": ["plasma", "webstorm"]
            }
          },
          "required": ["mode", "tool"],
          "additionalProperties": false
        }
      ]
    }
  }
}
