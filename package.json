{
  "name": "@shinaps/skills",
  "version": "0.36.0",
  "description": "Install Shinaps AI workflows and custom agents for Codex",
  "type": "module",
  "bin": {
    "shinaps-skills": "dist/bin/skills.js"
  },
  "files": [
    "dist/",
    "plugins/",
    ".agents/plugins/marketplace.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "check": "npm run format:check && tsc --noEmit",
    "verify:package": "node scripts/verify-package.ts",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sh1n4ps/shinaps-skills.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
