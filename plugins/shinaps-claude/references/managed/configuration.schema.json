{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cdn.jsdelivr.net/npm/@shinaps/skills@0.38.0/plugins/shinaps-claude/references/managed/configuration.schema.json",
  "title": "Shinaps Managed Agents configuration v2",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "config_version": {
      "type": "integer",
      "const": 2
    },
    "repository": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "mount_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["url", "mount_path"],
      "additionalProperties": false
    },
    "accounts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "vault_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["vault_id"],
        "additionalProperties": false
      }
    }
  },
  "required": ["config_version", "repository", "accounts"],
  "additionalProperties": false
}
